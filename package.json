{
  "name": "flowdesk-wa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --filter @flowdesk/wa-api dev",
    "build": "pnpm --filter @flowdesk/wa-api build",
    "start": "pnpm --filter @flowdesk/wa-api start",
    "setup:vm-env": "node scripts/setup-vm-env.mjs",
    "send:vm-env": "bash scripts/send-vm-env.sh",
    "compose:up": "docker compose -f docker-compose.https.pull.yml up -d",
    "compose:pull": "docker compose -f docker-compose.https.pull.yml pull"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "firebase": "^11.6.0"
    }
  }
}
